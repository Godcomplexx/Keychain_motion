#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

#include "../dts/e73_partitions.dtsi"

/*
 * Final Gerber target: EBYTE E73-2G4M08S1C.
 * U4 pin 14 = P0.06/SCL, U4 pin 16 = P0.08/SDA.
 */
/ {
    aliases {
        keychain-i2c = &i2c0;
    };
};

&pinctrl {
    keychain_i2c_default: keychain_i2c_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 6)>,
                    <NRF_PSEL(TWIM_SDA, 0, 8)>;
            bias-pull-up;
        };
    };

    keychain_i2c_sleep: keychain_i2c_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 6)>,
                    <NRF_PSEL(TWIM_SDA, 0, 8)>;
            low-power-enable;
        };
    };

    /*
     * Bodge-wired round GC9107 display, bypassing J2 (which stays on I2C for
     * the accelerometer). U4 pin 3 = P0.03 = SCK, U4 pin 4 = P0.28 = MOSI -
     * the two free, unshadowed pads on the module's outer left edge. CS, D/C
     * and RESET are plain GPIO, not part of the SPI peripheral, since the
     * display needs D/C toggled per byte and the SPI framework only knows how
     * to drive CS.
     */
    gc9107_spi_default: gc9107_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 28)>;
        };
    };

    gc9107_spi_sleep: gc9107_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 28)>;
            low-power-enable;
        };
    };
};

/*
 * spi1 and spi3 are already claimed by the stock nrf52840dk board file for its
 * own Arduino header, wired to pins this PCB does not expose. spi0 shares
 * silicon with i2c0, which the accelerometer bus already owns. spi2 is the
 * one instance nothing else on this board touches.
 */
&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&gc9107_spi_default>;
    pinctrl-1 = <&gc9107_spi_sleep>;
    pinctrl-names = "default", "sleep";
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&keychain_i2c_default>;
    pinctrl-1 = <&keychain_i2c_sleep>;
    pinctrl-names = "default", "sleep";
};

/*
 * The nrf52840dk console UART claims TX on P0.06 and RX on P0.08 - exactly the
 * two pins this PCB wires to I2C. Its push-pull TX output fights the open-drain
 * bus, so no device can ever acknowledge. The E73 PCB exposes no UART pins at
 * all, so the controller is removed from this build entirely.
 */
&uart0 {
    status = "disabled";
};

/*
 * The PCB does route USB-C to the module, so the console and the 1200-baud
 * update request both live on a USB CDC port instead. The DK devicetree has no
 * such node, so it is declared here.
 */
&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };

    /*
     * A second port for mcumgr. The SMP transport owns its UART completely, so
     * sharing one port with the console would corrupt both. Two CDC instances
     * cost one composite descriptor and keep logs readable during an update.
     */
    cdc_acm_uart1: cdc_acm_uart1 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,uart-mcumgr = &cdc_acm_uart1;
        /delete-property/ zephyr,shell-uart;
        /delete-property/ zephyr,bt-mon-uart;
        /delete-property/ zephyr,bt-c2h-uart;
    };

    /*
     * BAT_SENSE reaches U4 pin 7, which the EBYTE manual maps to P0.02 / AIN0.
     * The R17/R18 divider sits between the cell and this pin.
     */
    /*
     * The round display's control lines: E73 pin 1 = P1.11 (CS), pin 2 =
     * P1.10 (D/C), pin 6 = P1.13 (RESET) - the three free pads left over in
     * the same outer-left row once SCK and MOSI were assigned. CS and RESET
     * read low-active straight from the datasheet; D/C is a level select, not
     * an enable, so it carries no polarity of its own.
     */
    zephyr,user {
        io-channels = <&adc 0>;
        gc9107-cs-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
        gc9107-dc-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
        gc9107-reset-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
    };

    /*
     * ACC_INT1 reaches U4 pin 22 = P0.07. The LIS2DW12 drives it on wake-up.
     * A pull-down keeps the input quiet while the sensor is not soldered.
     */
    keychain_inputs {
        compatible = "gpio-keys";

        accel_int: accel_int {
            gpios = <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            label = "ACC_INT1";
        };
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        /* Gain 1/6 against the 0.6 V internal reference gives a 3.6 V span,
         * comfortably above the ~2.1 V a halved full cell produces. */
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };
};
